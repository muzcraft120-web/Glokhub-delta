-- küçült kapat
local kucult = Instance.new("TextButton", baslik)
kucult.Text = "−"
kucult.Size = UDim2.new(0,32,0,32)
kucult.Position = UDim2.new(1,-70,0,4)
kucult.BackgroundColor3 = Color3.fromRGB(255,170,0)
kucult.TextColor3 = Color3.new(1,1,1)
kucult.Font = Enum.Font.GothamBold

local kapat = Instance.new("TextButton", baslik)
kapat.Text = "×"
kapat.Size = UDim2.new(0,32,0,32)
kapat.Position = UDim2.new(1,-36,0,4)
kapat.BackgroundColor3 = Color3.fromRGB(255,70,70)
kapat.TextColor3 = Color3.new(1,1,1)
kapat.Font = Enum.Font.GothamBold

Instance.new("UICorner", kucult).CornerRadius = UDim.new(0,8)
Instance.new("UICorner", kapat).CornerRadius = UDim.new(0,8)

local kucuk = false
kucult.MouseButton1Click:Connect(function()
	kucuk = not kucuk
	ts:Create(ana, TweenInfo.new(0.3), {Size = kucuk and UDim2.new(0,400,0,40) or UDim2.new(0,400,0,480)}):Play()
end)
kapat.MouseButton1Click:Connect(function() gui:Destroy() end)

-- sürükleme
local surukle = false
local basla, baslaPos
baslik.InputBegan:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 then
		surukle = true
		basla = inp.Position
		baslaPos = ana.Position
	end
end)
baslik.InputChanged:Connect(function(inp)
	if surukle and (inp.UserInputType == Enum.UserInputType.MouseMovement) then
		local fark = inp.Position - basla
		ana.Position = UDim2.new(baslaPos.X.Scale, baslaPos.X.Offset + fark.X, baslaPos.Y.Scale, baslaPos.Y.Offset + fark.Y)
	end
end)
uis.InputEnded:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 then surukle = false end
end)

