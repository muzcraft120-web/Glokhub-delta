-- Toggle Function
local function makeToggle(name, posY, callback)
    local Frame = Instance.new("Frame")
    Frame.Parent = ScrollFrame
    Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Frame.Position = UDim2.new(0, 10, 0, posY)
    Frame.Size = UDim2.new(1, -20, 0, 50)
    local FCorner = Instance.new("UICorner")
    FCorner.CornerRadius = UDim.new(0, 10)
    FCorner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Parent = Frame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 15, 0, 0)
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.Font = Enum.Font.Gotham
    Label.Text = name
    Label.TextColor3 = Color3.new(1, 1, 1)
    Label.TextScaled = true
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Toggle = Instance.new("TextButton")
    Toggle.Parent = Frame
    Toggle.BackgroundColor3 = Color3.fromRGB(200, 100, 100)
    Toggle.Position = UDim2.new(1, -60, 0, 10)
    Toggle.Size = UDim2.new(0, 30, 0, 30)
    Toggle.Text = ""
    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(0, 15)
    TCorner.Parent = Toggle

    local Circle = Instance.new("Frame")
    Circle.Parent = Toggle
    Circle.BackgroundColor3 = Color3.new(1, 1, 1)
    Circle.Position = UDim2.new(0, 2, 0, 2)
    Circle.Size = UDim2.new(0, 26, 0, 26)
    local CC = Instance.new("UICorner")
    CC.CornerRadius = UDim.new(1, 13)
    CC.Parent = Circle

    local tog = false
    Toggle.MouseButton1Click:Connect(function()
        tog = not tog
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = tog and UDim2.new(1, -28, 0, 2) or UDim2.new(0, 2, 0, 2)}):Play()
        TweenService:Create(Toggle, TweenInfo.new(0.2), {BackgroundColor3 = tog and Color3.fromRGB(100, 200, 100) or Color3.fromRGB(200, 100, 100)}):Play()
        callback(tog)
    end)
end

-- Slider Function (Simple)
local function makeSlider(name, posY, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Parent = ScrollFrame
    Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Frame.Position = UDim2.new(0, 10, 0, posY)
    Frame.Size = UDim2.new(1, -20, 0, 60)
    local FCorner = Instance.new("UICorner")
    FCorner.CornerRadius = UDim.new(0, 10)
    FCorner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Parent = Frame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 15, 0, 0)
    Label.Size = UDim2.new(0.5, 0, 0.5, 0)
    Label.Font = Enum.Font.Gotham
    Label.Text = name
    Label.TextColor3 = Color3.new(1, 1, 1)
    Label.TextScaled = true
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Parent = Frame
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Position = UDim2.new(0.55, 0, 0, 0)
    ValueLabel.Size = UDim2.new(0.3, 0, 0.5, 0)
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.Text = tostring(default)
    ValueLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    ValueLabel.TextScaled = true

    local SliderBar = Instance.new("Frame")
    SliderBar.Parent = Frame
    SliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    SliderBar.Position = UDim2.new(0, 0, 0.6, 0)
    SliderBar.Size = UDim2.new(1, 0, 0.25, 0)
    local SCorner = Instance.new("UICorner")
    SCorner.CornerRadius = UDim.new(0, 6)
    SCorner.Parent = SliderBar

    local Fill = Instance.new("Frame")
    Fill.Parent = SliderBar
    Fill.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    local FCorner2 = Instance.new("UICorner")
    FCorner2.CornerRadius = UDim.new(0, 6)
    FCorner2.Parent = Fill

    local dragging = false
    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation()
            local relative = math.clamp((mousePos.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(relative, 0, 1, 0)
            local val = math.floor(min + (max - min) * relative)
            ValueLabel.Text = tostring(val)
            callback(val)
        end
    end)
end

-- Toggles & Sliders
makeToggle("Fullbright", 70, function(state)
    getgenv().Glok.Fullbright = state
    if state then
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 0
        Lighting.ClockTime = 0.5
        Lighting.Ambient = Color3.new(1, 1, 1)
    else
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.new(0.4, 0.4, 0.4)
    end
end)

makeSlider("Speed", 130, 16, 500, 100, function(val)
    getgenv().Glok.Speed = val
end)

makeSlider("Jump Power", 200, 50, 500, 100, function(val)
    getgenv().Glok.Jump = val
end)

makeToggle("Fly (F Tuşu)", 270, function(state)
    getgenv().Glok.Fly = state
end)

makeToggle("Noclip (H Tuşu)", 340, function(state)
    getgenv().Glok.Noclip = state
end)

-- Loops
RunService.Stepped:Connect(function()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = getgenv().Glok.Speed
        player.Character.Humanoid.JumpPower = getgenv().Glok.Jump
        if getgenv().Glok.Noclip then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- Fly
UserInputService.InputBegan:Connect(function(key)
    if key.KeyCode == Enum.KeyCode.F then
        getgenv().Glok.Fly = not getgenv().Glok.Fly
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            if getgenv().Glok.Fly then
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(4000, 4000, 4000)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = root
                rs.Heartbeat:Connect(function()
                    if getgenv().Glok.Fly then
                        bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * 50
                    end
                end)
            end
        end
    end
end)

