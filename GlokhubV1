--// HEROBRINE HUB V1.0 (GUI SCRIPT) – HİLESİZ, GÜVENLİ
local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.ResetOnSpawn = false

-- MAIN FRAME
local frame = Instance.new("Frame", gui)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.Size = UDim2.new(0, 450, 0, 300)
frame.Position = UDim2.new(0.3, 0, 0.3, 0)
frame.Active = true
frame.Draggable = true

-- TOP BAR
local topBar = Instance.new("Frame", frame)
topBar.Size = UDim2.new(1, 0, 0, 30)
topBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
topBar.BorderSizePixel = 0

local title = Instance.new("TextLabel", topBar)
title.Size = UDim2.new(0.6, 0, 1, 0)
title.BackgroundTransparency = 1
title.Text = "HEROBRINE HUB V1.0"
title.Font = Enum.Font.GothamBold
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true

-- ICON BUTTONS
local btn_min = Instance.new("TextButton", topBar)
btn_min.Size = UDim2.new(0, 40, 1, 0)
btn_min.Position = UDim2.new(0.6, 0, 0, 0)
btn_min.Text = "_"
btn_min.Font = Enum.Font.GothamBold
btn_min.TextScaled = true
btn_min.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
btn_min.TextColor3 = Color3.fromRGB(255, 255, 255)

local btn_max = Instance.new("TextButton", topBar)
btn_max.Size = UDim2.new(0, 40, 1, 0)
btn_max.Position = UDim2.new(0.6 + 0.09, 0, 0, 0)
btn_max.Text = "□"
btn_max.Font = Enum.Font.GothamBold
btn_max.TextScaled = true
btn_max.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
btn_max.TextColor3 = Color3.fromRGB(255, 255, 255)

local btn_close = Instance.new("TextButton", topBar)
btn_close.Size = UDim2.new(0, 40, 1, 0)
btn_close.Position = UDim2.new(0.6 + 0.18, 0, 0, 0)
btn_close.Text = "X"
btn_close.Font = Enum.Font.GothamBold
btn_close.TextScaled = true
btn_close.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
btn_close.TextColor3 = Color3.fromRGB(255, 255, 255)

-- CONTENT FRAME
local content = Instance.new("Frame", frame)
content.Size = UDim2.new(1, -10, 1, -40)
content.Position = UDim2.new(0, 5, 0, 35)
content.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
content.BorderSizePixel = 0

local pageLabel = Instance.new("TextLabel", content)
pageLabel.Size = UDim2.new(1, 0, 1, 0)
pageLabel.BackgroundTransparency = 1
pageLabel.Text = "Home\n\nUsername: "..player.Name..
                 "\nAccount Age: "..player.AccountAge.." days"
pageLabel.TextColor3 = Color3.fromRGB(255,255,255)
pageLabel.TextScaled = true
pageLabel.Font = Enum.Font.Gotham

-- SIDE BUTTONS
local buttons = {"Home", "Tools", "Settings", "Profile"}
local y = 35

for _, name in ipairs(buttons) do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 90, 0, 30)
    b.Position = UDim2.new(0, -95, 0, y)
    b.Text = name
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(55,55,55)
    y = y + 40

    b.MouseButton1Click:Connect(function()
        if name == "Home" then
            pageLabel.Text = "HOME\n\nUsername: "..player.Name..
            "\nAccount Age: "..player.AccountAge
        elseif name == "Tools" then
            pageLabel.Text = "TOOLS\n\n- FOV Control (Demo)\n- Light Mode\n- Transparency"
        elseif name == "Settings" then
            pageLabel.Text = "SETTINGS\n\n- Theme Color\n- UI Size\n- Animations"
        elseif name == "Profile" then
            pageLabel.Text = "PROFILE\n\nDisplay Name: "..player.DisplayName
        end
    end)
end

-- MINIMIZE
local originalSize = frame.Size
btn_min.MouseButton1Click:Connect(function()
    frame.Size = UDim2.new(0, 450, 0, 35)
end)

-- MAXIMIZE
btn_max.MouseButton1Click:Connect(function()
    frame.Size = originalSize
end)

-- CLOSE (panel tamamen kapanır)
local reopenBtn = Instance.new("TextButton", gui)
reopenBtn.Size = UDim2.new(0, 80, 0, 40)
reopenBtn.Position = UDim2.new(1, -90, 1, -50)
reopenBtn.Text = "HUB"
reopenBtn.Font = Enum.Font.GothamBold
reopenBtn.TextScaled = true
reopenBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
reopenBtn.TextColor3 = Color3.fromRGB(255,255,255)
reopenBtn.Visible = false

btn_close.MouseButton1Click:Connect(function()
    frame.Visible = false
    reopenBtn.Visible = true
end)

-- REOPEN
reopenBtn.MouseButton1Click:Connect(function()
    frame.Visible = true
    reopenBtn.Visible = false
end)
