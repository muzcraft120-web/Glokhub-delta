-- FONKSİYONLAR

-- Sürükleme
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

-- Tab değiştirme
local function switchTab(tabName)
	if tabName == "settings" then
		settingsContent.Visible = true
		gamesContent.Visible = false
		settingsTab.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
		gamesTab.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	elseif tabName == "games" then
		settingsContent.Visible = false
		gamesContent.Visible = true
		settingsTab.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
		gamesTab.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
	end
end

settingsTab.MouseButton1Click:Connect(function()
	switchTab("settings")
end)

gamesTab.MouseButton1Click:Connect(function()
	switchTab("games")
end)

-- Hız ayarlama
local function updateSpeed(percentage)
	local speed = math.floor(defaultSpeed + (maxSpeed - defaultSpeed) * percentage)
	humanoid.WalkSpeed = speed
	speedFill.Size = UDim2.new(percentage, 0, 1, 0)
	speedValue.Text = "Hız: " .. speed
end

speedSlider.MouseButton1Down:Connect(function()
	local function update()
		local mousePos = UserInputService:GetMouseLocation().X
		local sliderPos = speedSlider.AbsolutePosition.X
		local sliderSize = speedSlider.AbsoluteSize.X
		local percentage = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
		updateSpeed(percentage)
	end
	
	update()
	
	local connection
	connection = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			update()
		end
	end)
	
	local connection2
	connection2 = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			connection:Disconnect()
			connection2:Disconnect()
		end
	end)
end)

-- Double Jump
doubleJumpToggle.MouseButton1Click:Connect(function()
	doubleJumpEnabled = not doubleJumpEnabled
	if doubleJumpEnabled then
		doubleJumpToggle.BackgroundColor3 = Color3.fromRGB(60, 255, 60)
		doubleJumpToggle.Text = "AÇIK"
	else
		doubleJumpToggle.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		doubleJumpToggle.Text = "KAPALI"
	end
end)

humanoid.StateChanged:Connect(function(old, new)
	if new == Enum.HumanoidStateType.Landed then
		jumpCount = 0
	end
end)

UserInputService.JumpRequest:Connect(function()
	if doubleJumpEnabled then
		if jumpCount < 2 then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			jumpCount = jumpCount + 1
		end
	end
end)

